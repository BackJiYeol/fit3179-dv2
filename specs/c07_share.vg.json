{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "height": 380,
  "projection": {"type": "equalEarth"},
  "data": {
    "url": "data/WorldMapWithGraticules.topojson",
    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "'No Google Trends data for ' + datum.properties.NAME",
          "as": "note"
        }
      ],
      "mark": {"type": "geoshape", "fill": "#dfe3e8", "stroke": "#ffffff", "strokeWidth": 0.4},
      "encoding": {"tooltip": {"field": "note", "type": "nominal", "title": " "}}
    },
    {
      "data": {
        "url": "data/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "#eaf1f8"}
    },
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "#cfd8e3", "strokeWidth": 0.5}
    },
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {"url": "data/c07_share.json"},
            "key": "country",
            "fields": ["pct"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.4},
      "encoding": {
        "color": {
          "field": "pct",
          "type": "quantitative",
          "title": ["Pokémon's share of card", "game searches (%)"],
          "scale": {
            "type": "threshold",
            "domain": [65, 75, 85],
            "range": ["#c6dbef", "#6baed6", "#2171b5", "#08306b"]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "titleFontSize": 11,
            "titleLimit": 320,
            "labelFontSize": 10,
            "format": ".0f",
            "symbolType": "square",
            "symbolSize": 170,
            "offset": 6
          }
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {"field": "pct", "type": "quantitative", "title": "Pokémon share (%)", "format": ".0f"}
        ]
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
