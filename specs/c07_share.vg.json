{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "height": 380,
  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "center_to"
    },
    "scale": {
      "expr": "zoom_level"
    }
  },
  "data": {
    "url": "data/WorldMapWithGraticules.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },
  "layer": [
    {
      "transform": [
        {
          "calculate": "'Data is not available in ' + datum.properties.NAME",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#333b48",
        "stroke": "#0f1521",
        "strokeWidth": 1
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#1a2433"
      }
    },
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#2a3547",
        "strokeWidth": 0.5
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/c07_share.json"
            },
            "key": "country",
            "fields": [
              "pct"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape"
      },
      "encoding": {
        "color": {
          "field": "pct",
          "type": "quantitative",
          "title": [
            "Pokémon's share of card",
            "game searches (%)"
          ],
          "scale": {
            "type": "threshold",
            "domain": [
              65,
              75,
              85
            ],
            "range": [
              "#2f6a9e",
              "#3f8fcf",
              "#7cc0ee",
              "#cfe9fb"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "titleFontSize": 11,
            "titleLimit": 320,
            "labelFontSize": 10,
            "format": ".0f",
            "symbolType": "square",
            "symbolSize": 170,
            "offset": 6
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Pokémon share (%)",
            "format": ".0f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "hl_country",
            "empty": true,
            "value": 1
          },
          "value": 0.35
        },
        "stroke": {
          "condition": {
            "param": "hl_country",
            "empty": false,
            "value": "#ffffff"
          },
          "value": "#0f1521"
        },
        "strokeWidth": {
          "condition": {
            "param": "hl_country",
            "empty": false,
            "value": 1.6
          },
          "value": 0.4
        }
      },
      "name": "countries",
      "params": [
        {
          "name": "hl_country",
          "select": {
            "type": "point",
            "fields": [
              "properties.NAME"
            ],
            "on": "@countries_marks:pointerover",
            "clear": "pointerout"
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "zoom_level",
      "value": 130,
      "bind": {
        "input": "range",
        "min": 130,
        "max": 600,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [
        0,
        0
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            0,
            0
          ],
          [
            15,
            50
          ],
          [
            110,
            15
          ],
          [
            -95,
            25
          ],
          [
            140,
            -25
          ]
        ],
        "labels": [
          "Whole world",
          "Europe",
          "Asia",
          "North America",
          "Oceania"
        ],
        "name": "Map Centre: "
      }
    }
  ]
}