{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "height": 380,
  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "center_to"
    },
    "scale": {
      "expr": "zoom_level"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ddd",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eaf1f8"
      }
    },
    {
      "data": {
        "url": "data/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#cfd8e3",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/c08_symbol.json"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.65,
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "value",
          "type": "quantitative",
          "title": [
            "Search interest in",
            "\"trading cards\""
          ],
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              10,
              900
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "values": [
              10,
              25,
              50,
              100
            ],
            "titleFontSize": 11,
            "titleLimit": 320,
            "labelFontSize": 10,
            "offset": 6,
            "symbolFillColor": "#0072B2",
            "symbolOpacity": 0.72
          }
        },
        "color": {
          "value": "#0072B2"
        },
        "order": {
          "field": "value",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Search interest (0-100)"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "zoom_level",
      "value": 130,
      "bind": {
        "input": "range",
        "min": 130,
        "max": 600,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [
        0,
        0
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            0,
            0
          ],
          [
            15,
            50
          ],
          [
            110,
            15
          ],
          [
            -95,
            25
          ],
          [
            140,
            -25
          ]
        ],
        "labels": [
          "Whole world",
          "Europe",
          "Asia",
          "North America",
          "Oceania"
        ],
        "name": "Map Centre: "
      }
    }
  ]
}