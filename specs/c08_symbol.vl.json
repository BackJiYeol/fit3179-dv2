      "name": "zoom_level",
      "value": 130,
      "bind": {
        "input": "range",
        "min": 130,
        "max": 600,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [
        0,
        0
      ],
      "bind": {
        "input": "select",
        "options": [
          [
            0,
            0
          ],
          [
            15,
            50
          ],
          [
            110,
            15
          ],
          [
            -95,
            25
          ],
