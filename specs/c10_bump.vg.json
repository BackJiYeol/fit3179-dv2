{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "height": 200,
  "data": {
    "url": "data/c10_bump.json"
  },
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "sort": {
        "field": "period_order"
      },
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 9.5,
        "labelExpr": "(indexof(datum.value, 'Q1') > 0 || datum.value == '21 Q4') ? '20' + substring(datum.value, 0, 2) : ''"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 55
        },
        "strokeWidth": 2.5
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              4
            ],
            "reverse": true
          },
          "axis": {
            "values": [
              1,
              2,
              3,
              4
            ],
            "labelExpr": "'#' + datum.value",
            "title": [
              "Rank among the",
              "4 challengers"
            ]
          }
        },
        "order": {
          "field": "period_order"
        },
        "color": {
          "field": "game",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports cards",
              "Yu-Gi-Oh",
              "One Piece",
              "Magic: The Gathering"
            ],
            "range": [
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "quarter_name",
            "title": "Quarter"
          },
          {
            "field": "game",
            "title": "Game"
          },
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "avg_value",
            "title": "Average search interest"
          }
        ],
        "opacity": {
          "condition": {
            "param": "hl_game",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        },
        "strokeWidth": {
          "condition": {
            "param": "hl_game",
            "empty": false,
            "value": 4
          },
          "value": 2.5
        }
      },
      "params": [
        {
          "name": "hl_game",
          "select": {
            "type": "point",
            "fields": [
              "game"
            ],
            "on": "line:pointerover, symbol:pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.is_last"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "fontWeight": 600,
        "fontSize": 10.5
      },
      "encoding": {
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              4
            ],
            "reverse": true
          }
        },
        "text": {
          "field": "game"
        },
        "color": {
          "field": "game",
          "type": "nominal",
          "scale": {
            "domain": [
              "Sports cards",
              "Yu-Gi-Oh",
              "One Piece",
              "Magic: The Gathering"
            ],
            "range": [
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "hl_game",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "calculate": "({'Q1':'January–March','Q2':'April–June','Q3':'July–September','Q4':'October–December'})[substring(datum.period,3,5)] + ' 20' + substring(datum.period,0,2)",
      "as": "quarter_name"
    }
  ]
}