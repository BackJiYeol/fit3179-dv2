{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/c10_timeseries.json"
  },
  "height": 180,
  "config": {
    "view": {
      "stroke": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": 6
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": [
            "Search interest",
            "(index, 100 = peak week)"
          ]
        },
        "color": {
          "field": "game",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Pokémon",
              "Sports cards",
              "Yu-Gi-Oh",
              "One Piece",
              "Magic: The Gathering"
            ],
            "range": [
              "#56B4E9",
              "#E69F00",
              "#CC79A7",
              "#D55E00",
              "#009E73"
            ]
          },
          "legend": {
            "orient": "top",
            "columns": 3,
            "symbolType": "stroke",
            "labelLimit": 200,
            "labelFontSize": 12,
            "symbolStrokeWidth": 3
          }
        },
        "opacity": {
          "condition": {
            "param": "hl_game",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        },
        "strokeWidth": {
          "condition": {
            "param": "hl_game",
            "empty": false,
            "value": 3.2
          },
          "value": 2
        }
      }
    },
    {
      "params": [
        {
          "name": "hl_game",
          "select": {
            "type": "point",
            "fields": [
              "game"
            ],
            "on": "line:pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 12,
        "strokeOpacity": 0.01,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": 6
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": [
            "Search interest",
            "(index, 100 = peak week)"
          ]
        },
        "detail": {
          "field": "game",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Week",
            "format": "%d %b %Y"
          },
          {
            "field": "game",
            "type": "nominal",
            "title": "Game"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Search interest"
          }
        ]
      }
    }
  ]
}