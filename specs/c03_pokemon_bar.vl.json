{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "height": 340,
  "data": {
    "url": "data/c03_pokemon_bar_data.json"
  },
  "encoding": {
    "x": {
      "field": "era",
      "type": "ordinal",
      "scale": {
        "domain": [
          "Base",
          "Gym",
          "Neo",
          "Other",
          "E-Card",
          "EX",
          "NP",
          "POP",
          "Diamond & Pearl",
          "Platinum",
          "HeartGold & SoulSilver",
          "Black & White",
          "XY",
          "Sun & Moon",
          "Sword & Shield",
          "Scarlet & Violet",
          "Mega Evolution"
        ]
      },
      "axis": {
        "labelAngle": -45,
        "title": null,
        "labelFontSize": 10.5,
        "labelExpr": "({'NP':'Nintendo Promos','POP':'POP Series'}[datum.value] || datum.value) + ' (' + {'Base': '1999–2000', 'Gym': '2000', 'Neo': '2000–2002', 'Other': '2001–2022', 'E-Card': '2002–2003', 'EX': '2003–2007', 'NP': '2003', 'POP': '2004–2009', 'Diamond & Pearl': '2007–2008', 'Platinum': '2009', 'HeartGold & SoulSilver': '2010–2011', 'Black & White': '2011–2013', 'XY': '2013–2016', 'Sun & Moon': '2017–2019', 'Sword & Shield': '2019–2023', 'Scarlet & Violet': '2023–2025', 'Mega Evolution': '2025–2026'}[datum.value] + ')'",
        "labelLimit": 220
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": {
          "band": 0.62
        }
      },
      "encoding": {
        "y": {
          "field": "pct",
          "type": "quantitative",
          "stack": "zero",
          "scale": {
            "domain": [
              0,
              36
            ]
          },
          "axis": {
            "title": "Share of era's cards (%)",
            "format": ".0f"
          },
          "title": "Share of era's cards (%)"
        },
        "order": {
          "field": "bucket_order",
          "type": "ordinal"
        },
        "color": {
          "field": "bucket",
          "type": "nominal",
          "scale": {
            "domain": [
              "EX",
              "GX",
              "V / VMAX / VSTAR",
              "Mega (ex/EX)",
              "ex",
              "Other special"
            ],
            "range": [
              "#4477AA",
              "#EE6677",
              "#228833",
              "#CCBB44",
              "#66CCEE",
              "#AA3377"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "columns": 6,
            "labelFontSize": 10.5
          }
        },
        "tooltip": [
          {
            "field": "era",
            "title": "Era"
          },
          {
            "field": "years",
            "title": "Years"
          },
          {
            "field": "bucket",
            "title": "Category"
          },
          {
            "field": "value",
            "title": "Cards"
          },
          {
            "field": "era_total",
            "title": "Cards in era"
          },
          {
            "field": "pct",
            "title": "Share of era",
            "format": ".1f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "hl_bucket",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      },
      "params": [
        {
          "name": "hl_bucket",
          "select": {
            "type": "point",
            "fields": [
              "bucket"
            ],
            "on": "rect:pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "transform": [
        {
          "calculate": "{'Base': '1999–2000', 'Gym': '2000', 'Neo': '2000–2002', 'Other': '2001–2022', 'E-Card': '2002–2003', 'EX': '2003–2007', 'NP': '2003', 'POP': '2004–2009', 'Diamond & Pearl': '2007–2008', 'Platinum': '2009', 'HeartGold & SoulSilver': '2010–2011', 'Black & White': '2011–2013', 'XY': '2013–2016', 'Sun & Moon': '2017–2019', 'Sword & Shield': '2019–2023', 'Scarlet & Violet': '2023–2025', 'Mega Evolution': '2025–2026'}[datum.era]",
          "as": "years"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "era": "Base",
            "y": 7,
            "text": "1999–2002: under 2% of"
          },
          {
            "era": "Base",
            "y": 5,
            "text": "cards were \"special\""
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10.5,
        "fontWeight": 600,
        "color": "#e9edf3"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              36
            ]
          }
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "era": "Sword & Shield",
            "y": 34.6,
            "text": "the highest share in the dataset"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 10.5,
        "fontWeight": 600,
        "color": "#e9edf3"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              36
            ]
          }
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "era": "EX",
            "y": 28,
            "text": "lowercase \"ex\" first appeared in 2003"
          },
          {
            "era": "EX",
            "y": 26,
            "text": "— and returns 20 years later, in 2023"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 10.5,
        "fontWeight": 600,
        "color": "#e9edf3"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              36
            ]
          }
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}