{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/c01_ranking.json"
  },
  "height": 393,
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "game",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "scale": {
        "paddingInner": 0.3
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": [
        "Average relative search interest",
        "(Google Trends index, 100 = peak week)"
      ]
    },
    "tooltip": [
      {
        "field": "game",
        "type": "nominal",
        "title": "Game"
      },
      {
        "field": "value",
        "type": "quantitative",
        "title": "Search Interest"
      }
    ],
    "color": {
      "field": "game",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Pokémon",
          "Yu-Gi-Oh",
          "Sports cards",
          "Magic: The Gathering",
          "One Piece"
        ],
        "range": [
          "#56B4E9",
          "#CC79A7",
          "#E69F00",
          "#009E73",
          "#D55E00"
        ]
      }
    }
  }
}