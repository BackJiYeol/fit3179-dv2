{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 660,
  "height": 380,
  "autosize": {"type": "pad", "contains": "padding"},
  "signals": [
    {
      "name": "zoom_level",
      "value": 130,
      "bind": {"input": "range", "min": 130, "max": 600, "step": 10, "name": "Zoom: "}
    },
    {
      "name": "center_to",
      "value": [0, 0],
      "bind": {
        "input": "select",
        "options": [[0, 0], [15, 50], [110, 15], [-95, 25], [140, -25]],
        "labels": ["Whole world", "Europe", "Asia", "North America", "Oceania"],
        "name": "Map Centre: "
      }
    }
  ],
  "projections": [
    {
      "name": "proj",
      "type": "equalEarth",
      "scale": {"signal": "zoom_level"},
      "center": {"signal": "center_to"},
      "translate": [{"signal": "width / 2"}, {"signal": "height / 2"}]
    }
  ],
  "data": [
    {
      "name": "countries",
      "url": "data/WorldMapWithGraticules.topojson",
      "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },
    {
      "name": "oceans",
      "url": "data/oceans.topojson",
      "format": {"type": "topojson", "feature": "oceans"}
    },
    {
      "name": "graticules",
      "url": "data/WorldMapWithGraticules.topojson",
      "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
    },
    {
      "name": "pie_long",
      "url": "data/c09_pie_long.json",
      "format": {"type": "json"},
      "transform": [
        {
          "type": "geopoint",
          "projection": "proj",
          "fields": ["lon", "lat"],
          "as": ["cx", "cy"]
        },
        {
          "type": "stack",
          "groupby": ["country"],
          "sort": {"field": "order"},
          "field": "pct",
          "as": ["a0", "a1"]
        },
        {"type": "formula", "expr": "datum.a0 * 2 * PI / 100", "as": "startAngle"},
        {"type": "formula", "expr": "datum.a1 * 2 * PI / 100", "as": "endAngle"}
      ]
    },
    {
      "name": "country_pos",
      "source": "pie_long",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["country"],
          "fields": ["cx", "cy"],
          "ops": ["min", "min"],
          "as": ["cx", "cy"]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["Pokemon", "Yu-Gi-Oh", "Sports cards", "Magic: The Gathering", "One Piece"],
      "range": ["#d7dce2", "#CC79A7", "#E69F00", "#009E73", "#D55E00"]
    },
    {
      "name": "radiusScale",
      "type": "sqrt",
      "domain": [0, 44],
      "range": [0, 18],
      "zero": true,
      "clamp": true
    },
    {
      "name": "cxScale",
      "type": "ordinal",
      "domain": {"data": "country_pos", "field": "country"},
      "range": {"data": "country_pos", "field": "cx"}
    },
    {
      "name": "cyScale",
      "type": "ordinal",
      "domain": {"data": "country_pos", "field": "country"},
      "range": {"data": "country_pos", "field": "cy"}
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {"data": "oceans"},
      "encode": {"enter": {"fill": {"value": "#eaf1f8"}}},
      "transform": [{"type": "geoshape", "projection": "proj"}]
    },
    {
      "type": "shape",
      "from": {"data": "countries"},
      "encode": {
        "enter": {
          "fill": {"value": "#e4e4e4"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1}
        }
      },
      "transform": [{"type": "geoshape", "projection": "proj"}]
    },
    {
      "type": "shape",
      "from": {"data": "graticules"},
      "encode": {
        "enter": {
          "fill": {"value": null},
          "stroke": {"value": "#cfd8e3"},
          "strokeWidth": {"value": 0.5}
        }
      },
      "transform": [{"type": "geoshape", "projection": "proj"}]
    },
    {
      "type": "group",
      "from": {
        "facet": {
          "data": "pie_long",
          "name": "facet",
          "groupby": ["country"]
        }
      },
      "encode": {
        "enter": {
          "x": {"scale": "cxScale", "field": "country"},
          "y": {"scale": "cyScale", "field": "country"}
        }
      },
      "marks": [
        {
          "type": "arc",
          "from": {"data": "facet"},
          "encode": {
            "enter": {
              "x": {"value": 0},
              "y": {"value": 0},
              "startAngle": {"field": "startAngle"},
              "endAngle": {"field": "endAngle"},
              "innerRadius": {"value": 0},
              "outerRadius": {"scale": "radiusScale", "field": "total_nonpokemon"},
              "fill": {"scale": "color", "field": "game"},
              "stroke": {"value": "white"},
              "strokeWidth": {"value": 0.4},
              "tooltip": {
                "signal": "{'Country': datum.country, 'Game': datum.game, 'Share': format(datum.pct, '.0f') + '%', 'Non-Pokémon total': format(datum.total_nonpokemon, '.0f') + '%'}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "encode": {
        "enter": {
          "x": {"value": 4},
          "y": {"value": 160},
          "width": {"value": 128},
          "height": {"value": 98},
          "fill": {"value": "white"},
          "fillOpacity": {"value": 0.85},
          "stroke": {"value": "#d7dce2"}
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "enter": {
              "x": {"value": 8}, "y": {"value": 14},
              "text": {"value": "Non-Pokémon share"},
              "fontSize": {"value": 9}, "fontWeight": {"value": 700}, "fill": {"value": "#2b2f36"}
            }
          }
        },
        {
          "type": "symbol",
          "encode": {
            "enter": {
              "x": {"value": 30}, "y": {"value": 57},
              "shape": {"value": "circle"},
              "size": {"value": 925},
              "fill": {"value": "#bcbcbc"}, "fillOpacity": {"value": 0.55},
              "stroke": {"value": "#8a8a8a"}, "strokeWidth": {"value": 0.5}
            }
          }
        },
        {
          "type": "text",
          "encode": {"enter": {"x": {"value": 30}, "y": {"value": 86}, "align": {"value": "center"}, "text": {"value": "40%"}, "fontSize": {"value": 8.5}, "fill": {"value": "#555"}}}
        },
        {
          "type": "symbol",
          "encode": {
            "enter": {
              "x": {"value": 78}, "y": {"value": 64.6},
              "shape": {"value": "circle"},
              "size": {"value": 278},
              "fill": {"value": "#bcbcbc"}, "fillOpacity": {"value": 0.55},
              "stroke": {"value": "#8a8a8a"}, "strokeWidth": {"value": 0.5}
            }
          }
        },
        {
          "type": "text",
          "encode": {"enter": {"x": {"value": 78}, "y": {"value": 86}, "align": {"value": "center"}, "text": {"value": "12%"}, "fontSize": {"value": 8.5}, "fill": {"value": "#555"}}}
        },
        {
          "type": "symbol",
          "encode": {
            "enter": {
              "x": {"value": 112}, "y": {"value": 68.6},
              "shape": {"value": "circle"},
              "size": {"value": 93},
              "fill": {"value": "#bcbcbc"}, "fillOpacity": {"value": 0.55},
              "stroke": {"value": "#8a8a8a"}, "strokeWidth": {"value": 0.5}
            }
          }
        },
        {
          "type": "text",
          "encode": {"enter": {"x": {"value": 112}, "y": {"value": 86}, "align": {"value": "center"}, "text": {"value": "4%"}, "fontSize": {"value": 8.5}, "fill": {"value": "#555"}}}
        }
      ]
    },
    {
      "type": "group",
      "encode": {
        "enter": {
          "x": {"value": 8},
          "y": {"signal": "height - 70"}
        }
      },
      "marks": [
        {"type": "symbol", "encode": {"enter": {"x": {"value": 6}, "y": {"value": 0}, "shape": {"value": "square"}, "size": {"value": 90}, "fill": {"scale": "color", "value": "Pokemon"}}}},
        {"type": "text", "encode": {"enter": {"x": {"value": 14}, "y": {"value": 3}, "text": {"value": "Pokémon"}, "fontSize": {"value": 9}, "fill": {"value": "#2b2f36"}}}},
        {"type": "symbol", "encode": {"enter": {"x": {"value": 6}, "y": {"value": 14}, "shape": {"value": "square"}, "size": {"value": 90}, "fill": {"scale": "color", "value": "Yu-Gi-Oh"}}}},
        {"type": "text", "encode": {"enter": {"x": {"value": 14}, "y": {"value": 17}, "text": {"value": "Yu-Gi-Oh"}, "fontSize": {"value": 9}, "fill": {"value": "#2b2f36"}}}},
        {"type": "symbol", "encode": {"enter": {"x": {"value": 6}, "y": {"value": 28}, "shape": {"value": "square"}, "size": {"value": 90}, "fill": {"scale": "color", "value": "Sports cards"}}}},
        {"type": "text", "encode": {"enter": {"x": {"value": 14}, "y": {"value": 31}, "text": {"value": "Sports cards"}, "fontSize": {"value": 9}, "fill": {"value": "#2b2f36"}}}},
        {"type": "symbol", "encode": {"enter": {"x": {"value": 6}, "y": {"value": 42}, "shape": {"value": "square"}, "size": {"value": 90}, "fill": {"scale": "color", "value": "Magic: The Gathering"}}}},
        {"type": "text", "encode": {"enter": {"x": {"value": 14}, "y": {"value": 45}, "text": {"value": "Magic: The Gathering"}, "fontSize": {"value": 9}, "fill": {"value": "#2b2f36"}}}},
        {"type": "symbol", "encode": {"enter": {"x": {"value": 6}, "y": {"value": 56}, "shape": {"value": "square"}, "size": {"value": 90}, "fill": {"scale": "color", "value": "One Piece"}}}},
        {"type": "text", "encode": {"enter": {"x": {"value": 14}, "y": {"value": 59}, "text": {"value": "One Piece"}, "fontSize": {"value": 9}, "fill": {"value": "#2b2f36"}}}}
      ]
    }
  ],
  "config": {"view": {"stroke": null}}
}